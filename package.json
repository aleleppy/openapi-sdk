{
  "name": "@pinaculodigital/openapi-sdk",
  "version": "0.1.3",
  "description": "CLI + code generator that reads an OpenAPI 3.x spec and outputs typed TypeScript SDK modules with axios",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "openapi-sdk": "./dist/bin/cli.js"
  },
  "files": [
    "dist",
    "schemas"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "ts-node src/bin/cli.ts",
    "setup": "ts-node src/bin/cli.ts setup",
    "generate": "ts-node src/bin/cli.ts generate",
    "release": "npm run build && npm version patch && npm publish --access public"
  },
  "keywords": [
    "openapi",
    "sdk",
    "codegen",
    "typescript",
    "axios"
  ],
  "author": "Pináculo Digital <mangu@pinaculodigital.com.br>",
  "license": "MIT",
  "dependencies": {
    "@inquirer/prompts": "^8.3.2",
    "axios": "^1.7.0",
    "commander": "^12.1.0",
    "prettier": "^3.8.1"
  },
  "devDependencies": {
    "@types/node": "^20.19.37",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
